# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#testing-your-plugin)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-gyp dependency directory (https://github.com/nodejs/node-gyp#readme)
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_es/
.rts2_cache_umd/

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.development
.env.local
.env.production
.env.staging
.env.test

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build images
.next
out

# Nuxt.js build images
.nuxt
dist

# Gatsby files
.cache/
# Comment in the public line if your project uses Gatsby and you want to gitingore the public folder
# public

# vuepress build output
.vuepress/dist

# Serverless Webpack-plugin json file
.webpack

# Temporary files
.DS_Store
Thumbs.db

# Build files
/build/
dist/

# Python Virtual Environment
.venv/
__pycache__/
*.pyc

# Local workspace files
*.code-workspace

# Runtime downloaded assets (hashed on server, should not be committed)
public/extracted/*
!public/extracted/.gitkeep

# Debug / crawl artefacts
crawl_logs.txt
outre.html
product.json

# Local Prisma dev database (regenerated by prisma migrate deploy)
prisma/dev.sqlite
